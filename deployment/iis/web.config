<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="DleFaviconStaticFile" path="favicon.ico" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="C:\Program Files\nodejs\node.exe"
      arguments=".\apps\dashboard\server.js"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\dle-dashboard"
      startupTimeLimit="90"
      requestTimeout="00:10:00"
      processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="NEXT_TELEMETRY_DISABLED" value="1" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="DLE_AUTH_DATA_DIR" value=".\data\auth" />
        <!-- Prefer durable repo/site data (publish also sets absolute DLE_HRIS_DATA_DIR). Nested apps/dashboard/data/hris is fallback only. -->
        <environmentVariable name="DLE_HRIS_DATA_DIR" value="..\..\data\hris" />
        <!-- Relative to apps/dashboard cwd after server.js chdir → site/data/finance (publish-durable). -->
        <environmentVariable name="DLE_FINANCE_DATA_DIR" value="..\..\data\finance" />
        <!-- Public HTTPS entry (IIS binding). Keep LAN URL separately for internal mail defaults if needed. -->
        <environmentVariable name="DLE_PUBLIC_APP_URL" value="https://dleconnect.dormanlongeng.com:1432" />
        <environmentVariable name="NEXT_PUBLIC_APP_URL" value="https://dleconnect.dormanlongeng.com:1432" />
        <environmentVariable name="APP_URL" value="https://dleconnect.dormanlongeng.com:1432" />
        <environmentVariable name="DLE_INTERNAL_APP_URL" value="http://192.168.5.5:3020" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <outboundRules>
        <!-- Preserve client scheme: public users hit HTTPS:1432; do not force http:// which breaks the binding. -->
        <rule name="Rewrite HttpPlatform localhost redirects HTTPS" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^https?://(?:localhost|127\.0\.0\.1):[0-9]+/(.*)$" />
          <conditions>
            <add input="{HTTPS}" pattern="on" />
          </conditions>
          <action type="Rewrite" value="https://{HTTP_HOST}/{R:1}" />
        </rule>
        <rule name="Rewrite HttpPlatform localhost redirects HTTP" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^https?://(?:localhost|127\.0\.0\.1):[0-9]+/(.*)$" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Rewrite" value="http://{HTTP_HOST}/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="^30[1278]$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
